{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "edumonitor-auth",
    "Audience": "edumonitor-clients"
  },
  "Servicios": {
    "BackendUrl": "http://localhost:5000"
  },
  "Ollama": {
    "Url": "http://localhost:11434",
    "Modelo": "qwen2.5:7b",
    "TimeoutSegundos": 180,
    "Temperatura": 0.1,
    "ContextoTokens": 6144,
    "KeepAlive": "60m",
    "MaxTokensHerramientas": 300,
    "MaxTokensRespuesta": 900
  },
  "Agente": {
    "RutaRapida": true
  },
  "Gemini": {
    "Modelo": "gemini-flash-lite-latest",
    "NivelPensamiento": "minimal",
    "Temperatura": 0.2,
    "MaxTokensRespuesta": 2048,
    "TimeoutSegundos": 45,
    "ModeloAlternativo": "gemini-3.5-flash"
  }
}
