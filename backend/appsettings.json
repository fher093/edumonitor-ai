{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "edumonitor-auth",
    "Audience": "edumonitor-clients",
    "ExpMinutes": 60
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 5
  },
  "RateLimit": {
    "LoginPerMinute": 20
  }
}
