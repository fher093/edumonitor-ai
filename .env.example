# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" al repositorio.
# Evita los caracteres  $  ;  "  '  #  dentro de las contraseñas (rompen docker compose o la cadena de conexión).

# ---- SQL Server ----
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos (requisito de SQL Server)
MSSQL_SA_PASSWORD=CambiaEsta-ClaveSA-2026
DB_NAME=EduMonitor

# ---- JWT (mínimo 32 caracteres, aleatoria) ----
# Genera una con:  openssl rand -base64 48     o en PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}) -as [byte[]])
JWT_KEY=
JWT_ISSUER=edumonitor-auth
JWT_AUDIENCE=edumonitor-clients
JWT_EXP_MINUTES=60

# ---- Entorno ASP.NET (Development habilita /scalar/v1 y /openapi/v1.json) ----
ASPNETCORE_ENVIRONMENT=Development

# ---- Usuarios iniciales (se crean al arrancar si no existen; dejar vacío para omitir) ----
SEED_ADMIN_NOMBRE=Administrador técnico
SEED_ADMIN_CORREO=admin@edumonitor.local
SEED_ADMIN_PASSWORD=

SEED_DOCENTE_NOMBRE=Docente de prueba
SEED_DOCENTE_CORREO=docente@edumonitor.local
SEED_DOCENTE_PASSWORD=
